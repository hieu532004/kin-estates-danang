{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "functions": {
    "api/index.js": {
      "includeFiles": "{src/data/**,public/index.html}"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/robots.txt",
      "destination": "/api/index.js"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/index.js"
    },
    {
      "source": "/llms.txt",
      "destination": "/api/index.js"
    },
    {
      "source": "/kin-studio",
      "destination": "/studio-panel.html"
    },
    {
      "source": "/kin-studio/(.*)",
      "destination": "/studio-panel.html"
    },
    {
      "source": "/((?!api/|css/|js/|img/|videos/|studio-panel\\.html|index\\.html).*)",
      "destination": "/api/index.js"
    }
  ]
}
